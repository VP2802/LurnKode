# ==============================================================================
# LurnKode — Assessment Microservice (M3) Environment Variables
# Refer to docs/guides/environment-setup.md for platform conventions.
# Copy to .env for local development (do not commit actual secrets to Git).
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4003
HOST=0.0.0.0

# Database (Dedicated PostgreSQL instance for M3 - Database-per-Service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lurnkode_assessment?schema=public

# Task Queue & Events (Redis + BullMQ)
REDIS_URL=redis://localhost:6380

# Inter-Service Communication (M2 Course Service, served by the M1/M2 `api` app)
M2_COURSE_SERVICE_URL=http://localhost:8000
M2_REQUEST_TIMEOUT_MS=2000
# Must match INTERNAL_SERVICE_KEY of the api app (defaults to INTERNAL_SERVICE_TOKEN)
M2_INTERNAL_SERVICE_KEY=lurnkode_internal_secret_key_m4

# Security & Internal Tokens
INTERNAL_SERVICE_TOKEN=m3-internal-secret-token

# M1 identity: verify M1 access tokens (set one of the two)
M1_JWKS_URL=http://localhost:8000/.well-known/jwks.json
JWT_PUBLIC_KEY=
JWT_ISSUER=https://lurnkode.local/m1
JWT_AUDIENCE=lurnkode-api
# Trust X-User-Id / X-User-Role headers (default: true outside production, false in production)
# TRUST_GATEWAY_HEADERS=true

# M6 Judge Service (leave unset to grade with scripts/fake-judge.ts)
# JUDGE_API_URL=http://localhost:4000
# JUDGE_API_TOKEN=dev-m3-token
# JUDGE_CALLBACK_TOKEN=dev-callback-token
JUDGE_REQUEST_TIMEOUT_MS=3000
